  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#74737c",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.control"
        ],
        "settings": {
          "foreground": "#8bafff"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call"
        ],
        "settings": {
          "foreground": "#be84fb"
        }
      },
      {
        "scope": [
          "variable",
          "meta.definition.variable.name"
        ],
        "settings": {
          "foreground": "#cccbd1"
        }
      },
      {
        "scope": [
          "string",
          "punctuation.definition.string"
        ],
        "settings": {
          "foreground": "#67d283"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#f1bf4e"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "support.class"
        ],
        "settings": {
          "foreground": "#4fcdcd"
        }
      },
      {
        "scope": [
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#9d69d2"
        }
      },
      {
        "scope": [
          "punctuation"
        ],
        "settings": {
          "foreground": "#9e9da5"
        }
      },
      {
        "scope": [
          "entity.name.tag"
        ],
        "settings": {
          "foreground": "#8bafff"
        }
      },
      {
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#f1bf4e"
        }
      },
      {
        "scope": [
          "invalid"
        ],
        "settings": {
          "foreground": "#f24e56"
        }
      }
    ]
  }
}
