    "editor.selectionBackground": "#301d43",
    "editor.lineHighlightBackground": "#14131a",
    "editorLineNumber.foreground": "#55545d",
    "editorLineNumber.activeForeground": "#be84fb",
    "editorIndentGuide.background1": "#1e1d25",
    "editorIndentGuide.activeBackground1": "#3c3a44",
    "editorWhitespace.foreground": "#1e1d25",
    "editorWidget.background": "#1e1d25",
