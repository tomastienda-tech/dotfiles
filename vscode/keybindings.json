// Hyper (⌃⌥⌘) navigation for VS Code, matching the AeroSpace convention:
// Hyper + letter means "go to a place".
//
// Letter choice is constrained, not aesthetic. AeroSpace binds plain Hyper on
// b f h j k l n p q r t, the digits, the arrows, = ; [ ] — those are GLOBAL
// hotkeys and never reach VS Code at all. Karabiner takes a c v x z s w (→ ⌘)
// and r (→ ⌃R). What is left is d e g i m o u y plus the symbols, so the
// bindings below come out of that set.
//
// Hyper+SHIFT is deliberately avoided here: pi uses ✦⇧N/T/F/R for its session
// commands, and when pi runs in VS Code's integrated terminal, VS Code would
// swallow those before the terminal ever saw them.
//
// Each view binding toggles: pressing it while already in that view returns
// focus to the editor, so the same key gets you there and back.
[
  {
    "key": "ctrl+alt+cmd+e",
    "command": "workbench.view.explorer",
    "when": "!explorerViewletFocus"
  },
  {
    "key": "ctrl+alt+cmd+e",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "explorerViewletFocus"
  },

  // There is no scmViewletFocus context key — the Explorer has one, SCM does
  // not. `sideBarFocus && activeViewlet` is how VS Code itself expresses this,
  // and it works for any view without needing a per-view key.
  {
    "key": "ctrl+alt+cmd+g",
    "command": "workbench.view.scm",
    "when": "!(sideBarFocus && activeViewlet == 'workbench.view.scm')"
  },
  {
    "key": "ctrl+alt+cmd+g",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm'"
  },

  { "key": "ctrl+alt+cmd+o", "command": "workbench.action.quickOpen" },

  // Terminal is ✦Y, not ✦`, because ✦` did not fire on a US layout.
  //
  // Cause NOT established. The obvious theory — ⌥` is the dead key for a grave
  // accent — does not hold up, since ⌥E is the acute-accent dead key and ✦E
  // works fine, so ⌘ evidently suppresses composition. Other candidates are
  // ⌘` being a standard Cocoa window-cycling shortcut that the app menu still
  // claims, or VS Code's parsing of the backquote token. Not worth chasing:
  // a letter avoids the whole class of problem, and VS Code's own ⌃` still
  // works for the terminal and involves no Option at all.
  {
    "key": "ctrl+alt+cmd+y",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+alt+cmd+y",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },

  // Diff navigation, in BOTH places a change can appear.
  //
  // workbench.action.editor.nextChange alone was the earlier mistake: it is
  // gated on the quick-diff provider, so it only moves between UNCOMMITTED
  // changes in a normal editor. Open a side-by-side diff — reviewing a PR,
  // which is most of what this editor is for — and it does nothing at all,
  // which is indistinguishable from a broken binding.
  {
    "key": "ctrl+alt+cmd+d",
    "command": "workbench.action.compareEditor.nextChange",
    "when": "isInDiffEditor"
  },
  {
    "key": "ctrl+alt+cmd+d",
    "command": "editor.action.dirtydiff.next",
    "when": "!isInDiffEditor"
  },
  {
    "key": "ctrl+alt+cmd+shift+d",
    "command": "workbench.action.compareEditor.previousChange",
    "when": "isInDiffEditor"
  },
  {
    "key": "ctrl+alt+cmd+shift+d",
    "command": "editor.action.dirtydiff.previous",
    "when": "!isInDiffEditor"
  },

  // Zen moves from ✦U to ✦M, and Problems loses its key entirely: for an
  // editor used to read code, a diagnostics panel does not earn a Hyper slot,
  // and ⌘⇧M still opens it.
  { "key": "ctrl+alt+cmd+m", "command": "workbench.action.toggleZenMode" },

  // Escape leaves the terminal without needing the mouse. Vim's own Escape
  // still works inside the editor — this only applies with the terminal
  // focused and no text selected, so it cannot eat a selection-clear.
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus && !terminalTextSelected"
  }
]
